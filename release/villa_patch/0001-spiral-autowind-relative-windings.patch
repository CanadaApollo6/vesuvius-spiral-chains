+#!/usr/bin/env python3
+"""Check a relative_windings.json (e.g. from autowind) with this commit's point-collection loader.
+
+    python check_relative_windings.py relative_windings.json [--umbilicus umbilicus.json] [--spacing 16]
+
+Reports: collections, points, all points annotated, chains whose wind_a decreases (must be 0), points the
+default pcl_unattached_pcl_min_point_spacing would drop (use 0 for autowind chains), and with --umbilicus the largest
+angular jump between consecutive chain points. Exit status 1 if the file does not load or any wind_a decreases.
+"""
+import argparse
+import json
+import sys
+
+import numpy as np
+
+from point_collection import load_point_collection, normalise_pcl_winding_annotations
+from umbilicus import json_umbilicus_z_to_yx
+
+
+def decimate_keep(zyx, min_spacing):
+    # same greedy rule as spiral_helpers._decimate_ordered_points_min_spacing (last point forced, as fit_spiral does)
+    if min_spacing <= 0 or len(zyx) <= 1:
+        return len(zyx)
+    keep, last = 1, zyx[0]
+    for i in range(1, len(zyx)):
+        if i == len(zyx) - 1 or np.linalg.norm(zyx[i] - last) >= min_spacing:
+            keep, last = keep + 1, zyx[i]
+    return keep
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("json")
+    ap.add_argument("--umbilicus", default=None)
+    ap.add_argument("--spacing", type=float, default=16.0, help="min point spacing to evaluate (config default 16)")
+    a = ap.parse_args()
+    cols = load_point_collection(a.json)
+    if not cols:
+        print(f"could not load {a.json}")
+        return 1
+    normalise_pcl_winding_annotations(cols)
+    umb = json_umbilicus_z_to_yx(a.umbilicus) if a.umbilicus else None
+    n_pts = bad = dropped = 0
+    dth = 0.0
+    for c in cols.values():
+        pts = [p for _, p in sorted(c["points"].items(), key=lambda kv: int(kv[0]))]
+        w = np.array([p["winding_annotation"] for p in pts], float)
+        zyx = np.array([[p["p"][2], p["p"][1], p["p"][0]] for p in pts], float)
+        n_pts += len(pts)
+        bad += int((np.diff(w) < 0).any())
+        dropped += len(pts) - decimate_keep(zyx, a.spacing)
+        if umb is not None and len(pts) > 1:
+            yx = umb(zyx[:, 0])
+            th = np.unwrap(np.arctan2(zyx[:, 1] - yx[:, 0], zyx[:, 2] - yx[:, 1]))
+            dth = max(dth, float(np.abs(np.diff(th)).max()))
+    s = dict(collections=len(cols), points=n_pts,
+             all_annotated=all(c["has_winding_annotations"] for c in cols.values()),
+             chains_with_decreasing_wind_a=bad, points_dropped_at_spacing=dropped, spacing=a.spacing,
+             frac_dropped=round(dropped / max(n_pts, 1), 3))
+    if umb is not None:
+        s["max_consecutive_dtheta_rad"] = round(dth, 4)
+    print(json.dumps(s, indent=1))
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
