+def compute_unattached_robust_cuts(slice_to_spiral_transform, dr_per_winding, pcl_strips, cfg):
+    # Robust ("self-cleaning") strips: evaluate every strip under the current fit and
+    # return, per strip, the indices k of the consecutive-point steps (k -> k+1) to
+    # cut. A step is flagged when its fitted winding difference departs from the
+    # annotated one by >= unattached_pcl_robust_step_threshold windings, i.e. when
+    # |delta(normalised shifted radius)| / dr >= threshold (the annotation is already
+    # subtracted in the normalised radius). With unattached_pcl_robust_window = W > 0
+    # a step is cut when the flagged fraction over steps k-W..k+W (clipped to the
+    # strip) is >= unattached_pcl_robust_window_threshold, otherwise every flagged
+    # step is cut. Strips carrying fiber-link junctions are never cut.
+    from satisfaction_metrics import _build_strip_spiral_context
+    num_strips = len(pcl_strips)
+    empty = [np.zeros(0, dtype=np.int64) for _ in range(num_strips)]
+    stats = {'strips': num_strips, 'steps': 0, 'flagged_steps': 0, 'cut_steps': 0, 'cut_strips': 0}
+    if num_strips == 0:
+        return empty, stats
+    flat = _build_strip_flat_bundle(((s['zyxs'], s['windings']) for s in pcl_strips), dr_per_winding.device)
+    with torch.no_grad():
+        ctx, _, _ = _build_strip_spiral_context(slice_to_spiral_transform, dr_per_winding, flat, num_strips)
+        if ctx is None:
+            return empty, stats
+        nr = (ctx['normalised_radii'] / ctx['dr']).double().cpu().numpy()
+    starts = flat['starts_cpu'].numpy()
+    step_threshold = float(cfg['unattached_pcl_robust_step_threshold'])
+    window = int(cfg['unattached_pcl_robust_window'])
+    window_threshold = float(cfg['unattached_pcl_robust_window_threshold'])
+    cuts = []
+    for i, strip in enumerate(pcl_strips):
+        lo, hi = int(starts[i]), int(starts[i + 1])
+        if hi - lo < 2:
+            cuts.append(np.zeros(0, dtype=np.int64))
+            continue
+        flagged = np.abs(np.diff(nr[lo:hi])) >= step_threshold
+        stats['steps'] += len(flagged)
+        stats['flagged_steps'] += int(flagged.sum())
+        if strip.get('link_points'):
+            cuts.append(np.zeros(0, dtype=np.int64))
+            continue
+        if window > 0:
+            csum = np.concatenate([[0], np.cumsum(flagged)])
+            k = np.arange(len(flagged))
+            w_lo = np.maximum(k - window, 0)
+            w_hi = np.minimum(k + window + 1, len(flagged))
+            cut = (csum[w_hi] - csum[w_lo]) / (w_hi - w_lo) >= window_threshold
+        else:
+            cut = flagged
+        cut_idx = np.nonzero(cut)[0].astype(np.int64)
+        stats['cut_steps'] += len(cut_idx)
+        stats['cut_strips'] += int(len(cut_idx) > 0)
+        cuts.append(cut_idx)
+    return cuts, stats
+
+
+def split_unattached_strips(pcl_strips, sampling_groups, cuts, min_piece_points):
+    # Split each strip at its cut steps (step k separates points k and k+1); pieces
+    # with fewer than max(2, min_piece_points) points are dropped. Uncut strips are
+    # passed through unchanged (same dict). Pieces keep the strip's id and sampling
+    # group, and carry 'robust_piece' (piece index within the strip).
+    pieces, groups = [], []
+    min_points = max(2, int(min_piece_points))
+    for strip, group, cut in zip(pcl_strips, sampling_groups, cuts):
+        if len(cut) == 0:
+            if len(strip['zyxs']) >= min_points:
+                pieces.append(strip)
+                groups.append(group)
+            continue
+        n = len(strip['zyxs'])
+        bounds = [0] + [int(k) + 1 for k in cut] + [n]
+        for piece_idx, (lo, hi) in enumerate(zip(bounds[:-1], bounds[1:])):
+            if hi - lo < min_points:
+                continue
+            piece = dict(strip)
+            piece['zyxs'] = strip['zyxs'][lo:hi]
+            piece['windings'] = strip['windings'][lo:hi]
+            if 'weights' in strip:
+                piece['weights'] = strip['weights'][lo:hi]
+            piece['link_points'] = {}
+            piece['robust_piece'] = piece_idx
+            pieces.append(piece)
+            groups.append(group)
+    return pieces, groups
+
