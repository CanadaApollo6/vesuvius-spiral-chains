+                               'cuts': [c.tolist() for c in cuts]}, f)
+                os.replace(tmp, sidecar)
+        pieces, groups = split_unattached_strips(
+            orig, self._robust_orig_groups, cuts, cfg['unattached_pcl_robust_min_piece_points'])
+        n_orig = int(sum(len(s['zyxs']) for s in orig))
+        n_kept = int(sum(len(s['zyxs']) for s in pieces))
+        self.unattached_pcl_strips[:] = pieces
+        self.unattached_pcl_strips.flat = None
