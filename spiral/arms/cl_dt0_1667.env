# cl_dt0_1667 (test 12 PHerc1667 non-regression, notes/2026-10-25-chain-loss-prereg.md): the cl_dt0z7 setting on the
# PHerc1667 M2 arm = c1667_m2s1.env (no-gm chains p1667_m7_ray_c, weight 10, spacing 0, seed 1) except ARM,
# FIT_OVERRIDES (= cl_dt0z7) and VILLA_PATCH. Run only if cl_dt0z7 passes the dev gate.
SCROLL=PHerc1667
VOL=20251217075048
UM=9.596
SENSE=ACW
ARM=cl_dt0_1667
Z0=6500
Z1=8000
MASK_TAG=m7L2
MASK_LOCAL=$HOME/data/PHerc1667/masks/m7_L2_th0.2.zarr
TRACKS_DBM=
SURF_SDT=
REL_WINDINGS=$HOME/data/PHerc1667/windings/p1667_m7_ray_c/relative_windings.json
FIT_OVERRIDES='{"pcl_unattached_pcl_min_point_spacing": 0.0, "loss_weight_unattached_pcl_radius": 10.0, "loss_weight_unattached_pcl_dt": 0.0}'
STEPS=
VILLA_PATCH=chain_loss_tol.patch
