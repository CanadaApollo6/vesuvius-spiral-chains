# p4_ms2 (PHercParis4 third confirmation region, notes/2026-10-23-third-region-prereg.md): METHOD, fixed recipe, NO gm raise (autowind chains --raise off), weight 10, spacing 0, seed 2
# Shared by all p4_* arms except ARM, REL_WINDINGS and FIT_OVERRIDES (seed: optimizer_random_seed, villa default 1).
# Fit frame = level 2 of the 2.400 um volume 20260411134726 (9.6 um), organisers' bucket m7-L2-th0.2 (band rows), public
# umbilicus / 4, sense CW (outward theta increases; labels and sense check).
SCROLL=PHercParis4
VOL=20260411134726
UM=9.6
SENSE=CW
ARM=p4_ms2
Z0=9000
Z1=10500
MASK_TAG=m7L2
MASK_LOCAL=$HOME/data/PHercParis4/masks/m7_L2_th0.2.zarr
TRACKS_DBM=
