# copy to arms/<name>.env; run: bash spiral/run_arm.sh spiral/arms/<name>.env (on the pod)
ARM=armX
MASK_TAG=ourmaskX                 # cache key for tracks/SDT built from the mask below
MASK_S3=                          # s3:// zarr with levels 0 and 1, or
MASK_LOCAL=                       # local zarr on the pod with levels 0 and 1
TRACKS_DBM=                       # prebuilt tracks DBM (+ .vctracks + .crossings.npz) -> skips extraction
SURF_SDT=                         # prebuilt surf-SDT ome.zarr (group 1, kind surf_sdt) -> skips make_surf_sdt
REL_WINDINGS=                     # relative_windings.json (our automatic winding annotations), copied to the dataset
FIT_OVERRIDES=                    # JSON merged over recipe overrides, e.g. '{"loss_weight_rel_winding": 10}'
STEPS=                            # default 30000
