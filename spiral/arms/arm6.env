# arm6: oracle with 10% of steps flipped (corrupt10), weight 10. Same band, mask (bucket m7) and track/SDT extraction as arm0; adds relative_windings.json from
# data/scratch/auto_windings/band_corrupt10/ (uploaded to $HOME/data/PHerc0139/windings/band_corrupt10/). With input_disable_patches every
# chain is an unattached strip; min point spacing 0 keeps every chain point (default 16 decimates 10-20 vox sheets).
ARM=arm6
MASK_TAG=m7pub
MASK_S3=s3://vesuvius-challenge-open-data/PHerc0139/representations/predictions/surfaces/20250728140407-surface-20260413222639-surface-m7-L0-th0.2.zarr
TRACKS_DBM=
SURF_SDT=
REL_WINDINGS=$HOME/data/PHerc0139/windings/band_corrupt10/relative_windings.json
FIT_OVERRIDES='{"pcl_unattached_pcl_min_point_spacing": 0.0, "loss_weight_unattached_pcl_radius": 10.0}'
STEPS=
