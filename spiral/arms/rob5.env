# rob5 (robust-fitter DEV, band 1, S2; compare arm23, base arm0): patch spiral/patches/robust_unattached.patch; windings band_m7_ray_gmxc, weight 10, spacing 0.
# S1 = chain-free warm-up to step 12000, then cut every chain step the warm-up fit disagrees with by >= 0.5 winding, drop pieces < 3 points, frozen.
# S2 = classic IRLS: chains on from step 0; from step 10000, every 2000 steps re-cut the original chains at steps the current fit disagrees with by >= 0.5.
ARM=rob5
Z0=3000
Z1=4500
MASK_TAG=m7pub
MASK_S3=s3://vesuvius-challenge-open-data/PHerc0139/representations/predictions/surfaces/20250728140407-surface-20260413222639-surface-m7-L0-th0.2.zarr
TRACKS_DBM=
SURF_SDT=
REL_WINDINGS=$HOME/data/PHerc0139/windings/band_m7_ray_gmxc/relative_windings.json
VILLA_PATCH=robust_unattached.patch
FIT_OVERRIDES='{"pcl_unattached_pcl_min_point_spacing": 0.0, "loss_weight_unattached_pcl_radius": 10.0, "unattached_pcl_robust_mode": "cut", "unattached_pcl_robust_start_step": 10000, "unattached_pcl_robust_update_interval": 2000, "unattached_pcl_robust_warmup_scale": 1.0, "unattached_pcl_robust_step_threshold": 0.5, "unattached_pcl_robust_window": 0, "unattached_pcl_robust_min_piece_points": 2}'
STEPS=
