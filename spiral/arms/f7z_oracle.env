# f7z_oracle (f7 confirmation, copy of f6z_oracle.env with ARM, Z0/Z1 and the oracle set renamed; PHercParis4 z 10800-11800, notes/2026-10-24-f7-confirm-prereg.md): CEILING (informativeness), reference-label oracle chains (auto_windings oracle probes, dtheta 15), weight 10, spacing 0, seed 1
# Shared by all f4_* arms except ARM, REL_WINDINGS and FIT_OVERRIDES (seed: optimizer_random_seed, villa default 1).
# Fit frame = level 2 of the 2.400 um volume 20260411134726 (9.6 um), organisers' bucket m7-L2-th0.2 (z 10800 band rows,
# local data/paris4_z10800/masks), public umbilicus / 4, sense CW. Same recipe as the p4_* arms except Z0/Z1.
SCROLL=PHercParis4
VOL=20260411134726
UM=9.6
SENSE=CW
ARM=f7z_oracle
Z0=10800
Z1=11800
MASK_TAG=m7L2
MASK_LOCAL=$HOME/data/PHercParis4/masks/m7_L2_th0.2.zarr
TRACKS_DBM=
SURF_SDT=
REL_WINDINGS=$HOME/data/PHercParis4/windings/band_oracle_p4z11/relative_windings.json
FIT_OVERRIDES='{"pcl_unattached_pcl_min_point_spacing": 0.0, "loss_weight_unattached_pcl_radius": 10.0}'
STEPS=
