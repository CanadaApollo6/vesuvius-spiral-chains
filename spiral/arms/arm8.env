# arm8 (round 2): auto whole-ray chains (band_m7_ray: 664 chains, median 65 pts). Same band, mask (bucket m7) and track/SDT extraction as arm0; adds relative_windings.json from
# data/scratch/auto_windings/band_m7_ray/ (uploaded to $HOME/data/PHerc0139/windings/band_m7_ray/); min point spacing 0, weight 10.
ARM=arm8
MASK_TAG=m7pub
MASK_S3=s3://vesuvius-challenge-open-data/PHerc0139/representations/predictions/surfaces/20250728140407-surface-20260413222639-surface-m7-L0-th0.2.zarr
TRACKS_DBM=
SURF_SDT=
REL_WINDINGS=$HOME/data/PHerc0139/windings/band_m7_ray/relative_windings.json
FIT_OVERRIDES='{"pcl_unattached_pcl_min_point_spacing": 0.0, "loss_weight_unattached_pcl_radius": 10.0}'
STEPS=
